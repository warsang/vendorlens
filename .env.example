# --- LLM via hackathon LiteLLM gateway (OpenAI-compatible) ---
# Team leaders get the shared key from the check-in email / Discord.
LITELLM_API_BASE=https://litellm.neathack.example/v1
LITELLM_API_KEY=
LITELLM_MODEL=nova-micro

# --- neatlogs observability ---
# Project API key from app.neatlogs.com -> Settings -> API keys (the TOP key,
# NOT the nlw_ HTTP ingest key). Leave empty to run without tracing.
NEATLOGS_API_KEY=

# --- Crustdata company/people enrichment ---
# 5,000 free credits with promo code NEATLOGS-OCT2026 at app.crustdata.com.
# Leave empty to run in degraded mode (other tools still work).
CRUSTDATA_API_KEY=
